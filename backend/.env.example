# ============================================================================
# Hive Mind Memory Server — configuration template
#
# Copy to .env and fill in DATABASE_URL. Everything else has a working value.
# Generate an API key with: openssl rand -hex 32
# ============================================================================


# ============================================================================
# 1. REQUIRED — paste your Supabase connection string here
# ============================================================================
#
# Where to find it:
#   supabase.com -> your project -> Connect (top bar)
#   Pick the "Session pooler" tab. NOT "Direct connection".
#
# The two look similar and only one of them deploys:
#
#   Session pooler  (use this)
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#     ^ user has the project ref in it     ^ host contains "pooler"
#
#   Direct connection  (works locally, fails on Render)
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#     ^ user is plain "postgres"          ^ host starts with "db."
#
# Why it matters: db.<ref>.supabase.co publishes only an IPv6 address. Render
# and most free tiers have no IPv6 outbound, so the direct URI works on your
# laptop and then fails the moment it is deployed. The pooler host resolves on
# IPv4. `python scripts/check_env.py` flags this for you.
#
# Three things to check before you paste:
#   a) Replace [YOUR-PASSWORD] with the real database password.
#      (Forgot it? Project Settings -> Database -> Reset database password.)
#   b) Port 5432 (Session pooler), NOT 6543 (Transaction pooler) — SQLAlchemy
#      needs prepared statements.
#   c) Append ?sslmode=require at the end.
#
# If your password contains @ : / ? # or %, percent-encode it:
#   @ -> %40    : -> %3A    / -> %2F    ? -> %3F    # -> %23    % -> %25
#
DATABASE_URL=


# ============================================================================
# 2. AUTH — already generated for you, nothing to do
# ============================================================================
#
# This is the key Claude and ChatGPT will send in the X-API-Key header.
# Comma-separate to issue one key per agent, e.g. claude-key,chatgpt-key,
# so you can revoke one without touching the other.
# Leave it EMPTY only for local testing — an empty value means no auth at all.
#
API_KEYS=


# ============================================================================
# 3. AFTER DEPLOYING — only needed for ChatGPT
# ============================================================================
#
# Your deployed URL, e.g. https://hive-mind-memory.onrender.com
# It becomes the servers[] entry in /openapi.json, which ChatGPT Actions
# refuses to import without. Leave empty until the service is live.
#
PUBLIC_BASE_URL=


# Extra Host header values the /mcp endpoint accepts, comma-separated.
# The host from PUBLIC_BASE_URL is added automatically, so you normally leave
# this empty. Set it if you put a custom domain in front of the service.
MCP_ALLOWED_HOSTS=


# ============================================================================
# 4. EMBEDDINGS — sensible defaults, change nothing unless you want to
# ============================================================================
#
# EMBEDDING_BACKEND: auto | fastembed | sentence-transformers
#   auto              prefers fastembed, falls back to sentence-transformers
#   fastembed         ONNX. 251 MB RAM. Use this on Render/Railway free tiers.
#   sentence-transformers  PyTorch. 1.6 GB RAM, ~3x faster per call.
# Both produce identical vectors, so switching is safe at any time.
#
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Changing EMBEDDING_DIM invalidates every vector already stored.
# Decide once, early. 384 is correct for all-MiniLM-L6-v2.
EMBEDDING_DIM=384

# Load the model at startup instead of on the first request.
WARM_MODEL_ON_STARTUP=true


# ============================================================================
# 5. DATABASE SCHEMA — defaults are correct
# ============================================================================
#
# Creates the extension, table and indexes on boot if they are missing.
AUTO_MIGRATE=true

# hnsw (default) or ivfflat. Read backend/README.md section 3 before switching:
# an ivfflat index built on an empty table silently returns fewer rows than you
# asked for.
VECTOR_INDEX_TYPE=hnsw
HNSW_EF_SEARCH=100
IVFFLAT_LISTS=100
IVFFLAT_PROBES=10

# pgvector >= 0.8: keep walking the index until top_k rows survive the filters.
ITERATIVE_SCAN=true


# ============================================================================
# 6. BEHAVIOUR — tune later if you feel like it
# ============================================================================
DEFAULT_TOP_K=5
MAX_TOP_K=50
CONTEXT_LIMIT=10
CONTEXT_QUERY=project overview architecture plan tasks

# Comma-separated, or * for any origin. Tighten this once you know who calls it.
CORS_ORIGINS=*

LOG_LEVEL=INFO
APP_ENV=development
